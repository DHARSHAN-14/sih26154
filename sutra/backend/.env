# ─────────────────────────────────────────────────────────────────────────────
# Sutra Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=sutra
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# ── API ───────────────────────────────────────────────────────────────────────
API_PREFIX=/api
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/sutra.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-python-secrets-token-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── LLM / Model Backend ───────────────────────────────────────────────────────
# "sovereign" = local vLLM/Ollama (nothing leaves the machine)
# "fast"      = cloud API (OpenAI, Anthropic, Google)
MODEL_BACKEND=fast
LITELLM_LOCAL_BASE=http://localhost:8001
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── RAG / Retrieval ───────────────────────────────────────────────────────────
# Sources below this token count go Route A (full-context, no retrieval).
# Sources above go Route B (chunk -> embed -> hybrid search -> rerank).
RETRIEVAL_TOKEN_THRESHOLD=25000
ENABLE_ROUTE_B=true
ENABLE_KG=true

# ── Vector Store (Qdrant) ─────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_PREFIX=sutra

# ── Confidence Scoring ───────────────────────────────────────────────────────
# confidence = w1*extraction_agreement + w2*source_quality
#            + w3*support_count - w4*contradiction_penalty
CONFIDENCE_W1_EXTRACTION_AGREEMENT=0.35
CONFIDENCE_W2_SOURCE_QUALITY=0.30
CONFIDENCE_W3_SUPPORT_COUNT=0.20
CONFIDENCE_W4_CONTRADICTION_PENALTY=0.15

# Bands: < EXCLUDE_BELOW -> excluded from generation
#        < CAVEAT_BELOW  -> auto-caveated ("reportedly", "according to source")
#        >= CAVEAT_BELOW -> stated plainly
CONFIDENCE_EXCLUDE_BELOW=0.5
CONFIDENCE_CAVEAT_BELOW=0.75

# ── Validation ────────────────────────────────────────────────────────────────
ENTAILMENT_THRESHOLD=0.7
MAX_REPAIR_ATTEMPTS=2

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_VIDEO_PACKAGE=true
DEMO_MODE=false

# ── Storage ───────────────────────────────────────────────────────────────────
ARTIFACT_DIR=./data/artifacts
MAX_UPLOAD_SIZE_MB=100

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
